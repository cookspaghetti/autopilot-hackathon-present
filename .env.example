# ===================================================================
#      AUTOPILOT COMMAND CENTER - ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------------
#  Copy this file to .env to get started.
#  Defaults work out of the box — just run: make up
# ===================================================================

# ------------------------------------------------------------
# BACKEND
# ------------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:3001
LOG_LEVEL=INFO

# Auth bypass — all requests auto-authenticated as Dev User (admin role)
AUTH_BYPASS=true

# ------------------------------------------------------------
# SUPERVITY AUTO WORKFLOW API (backend only)
# ------------------------------------------------------------
# Obtain the bearer key from https://auto.supervity.ai/u/api-keys.
# Keep all values server-side; never prefix them with NEXT_PUBLIC_.
SUPERVITY_WORKFLOW_API_KEY=
SUPERVITY_WORKFLOW_TRIGGER_URL=https://auto-workflow-api.supervity.ai/api/v1/workflow-runs/execute/stream
SUPERVITY_ORCHESTRATOR_ID=019fe4b4-8515-7000-97a7-42405483dfc4
# Separate API-triggered workflow used by inbound Slack #insight mentions.
SUPERVITY_INSIGHT_WORKFLOW_ID=019fe24a-2089-7000-ac1e-1cbdd7ee7b78
SUPERVITY_WORKFLOW_SOURCE=external
SUPERVITY_USER_TIMEZONE=Asia/Kuala_Lumpur

# Workflow management APIs (workflow runs, user forms, and schedules).
# The base URL defaults to the /api/v1 root derived from the trigger URL.
SUPERVITY_API_BASE_URL=https://auto-workflow-api.supervity.ai/api/v1
# Integration inventory is served by Supervity's integration API.
SUPERVITY_INTEGRATION_API_BASE_URL=https://auto-integration-api.supervity.ai/api/v1
# Required when the Supervity organization is not implicit in the bearer token.
SUPERVITY_ACTIVE_ORG=

# Optional endpoints. Use {run_id} as the placeholder.
SUPERVITY_WORKFLOW_STATUS_URL_TEMPLATE=
SUPERVITY_WORKFLOW_RESUME_URL_TEMPLATE=
SUPERVITY_WORKFLOW_TIMEOUT_SECONDS=300
# The v9.1 Governance Demo declares no Command Center callback inputs.
# Keep false unless a published orchestrator explicitly declares them.
SUPERVITY_INCLUDE_CALLBACK_INPUTS=false

# Public backend URL used for Auto callbacks after deployment.
COMMAND_CENTER_API_URL=http://localhost:8001
COMMAND_CENTER_CALLBACK_SECRET=
COMMAND_CENTER_POLICY_STORE=supabase

# Slack ingress. Socket Mode is preferred for local/private deployments because
# it needs no public Request URL. Generate an xapp token with connections:write.
# Subscribe to app_mention and message.channels; the latter needs channels:history.
SLACK_APP_TOKEN=
# Passed to the Supervity workflow at run time so the reply uses the app identity.
SLACK_BOT_TOKEN=
# Keep the signed HTTP endpoint available for hosted deployments. Configure:
# https://your-public-backend.example/api/command-center/slack/events
SLACK_SIGNING_SECRET=
SLACK_SIGNATURE_MAX_AGE_SECONDS=300
SLACK_INSIGHT_WORKSPACE_KEY=default
# Auto signs callbacks with HMAC-SHA256(secret, command_center_run_id).
# Never expose either Slack token to the browser or commit them to source control.

# ------------------------------------------------------------
# OUTLOOK / MICROSOFT GRAPH (backend only)
# ------------------------------------------------------------
# Preferred durable delegated OAuth configuration. Register the redirect URI as
# a Web platform URI, not an SPA URI. MSAL keeps the short-lived access token
# refreshed from an encrypted server-side token cache.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT=consumers
OUTLOOK_REDIRECT_URI=http://localhost:8001/api/command-center/outlook/oauth/callback
OUTLOOK_OAUTH_SCOPES=Mail.Read User.Read
# Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key invalidates the stored token cache and requires reconnecting.
OUTLOOK_TOKEN_CACHE_KEY=
# Temporary fallback for Graph Explorer/local smoke tests only. The backend
# prefers OAuth above when all four required OAuth values are configured.
OUTLOOK_ACCESS_TOKEN=
OUTLOOK_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
OUTLOOK_TIMEOUT_SECONDS=10
# Shared secret for POST /api/command-center/outlook/poll when the scheduler
# does not authenticate with the application's normal bearer token.
OUTLOOK_POLL_SECRET=
# Safety bound for following Microsoft Graph delta pagination.
OUTLOOK_POLL_MAX_PAGES=25

# ------------------------------------------------------------
# SUPABASE OPERATIONAL PLANE (backend only)
# ------------------------------------------------------------
SUPABASE_URL=
# Preferred elevated backend key (sb_secret_...). Never expose it to the browser
# or place it in frontend/NEXT_PUBLIC_ variables.
SUPABASE_SECRET_KEY=
# Public low-privilege key (sb_publishable_...). Only needed by clients that
# access Supabase directly under RLS; the Command Center backend does not.
SUPABASE_PUBLISHABLE_KEY=
# Optional when verifying Supabase Auth user JWTs in a custom backend handler.
SUPABASE_JWKS_URL=
# Legacy compatibility. Prefer SUPABASE_SECRET_KEY for new projects.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_API_KEY=
# Administrative PostgreSQL connection used only by schema reset/reseed tooling.
# Copy it from Supabase's Connect panel and include sslmode=require. The role
# must be allowed to drop and recreate the application-owned public objects.
SUPABASE_DB_URL=
# Use Supabase's IPv4-compatible session pooler for local Docker.
SUPABASE_DB_POOLER_REGION=ap-southeast-1
SUPABASE_TIMEOUT_SECONDS=30

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
# Command Center control-plane persistence. For the live/demo environment,
# DATABASE_URL resolves to the Supabase PostgreSQL connection above and all
# SQLAlchemy/Alembic objects live in the dedicated command_center schema.
COMMAND_CENTER_DB_SCHEMA=command_center
DATABASE_URL=${SUPABASE_DB_URL}

# Optional local PostgreSQL fallback for isolated/offline development. Replace
# DATABASE_URL with the commented connection string and start Compose with
# `docker compose --profile local-db up` when using this service.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_BASE_PATH=

# NextAuth (required for session management even with AUTH_BYPASS)
NEXTAUTH_URL=http://localhost:3001

# REQUIRED: A secret used to sign and encrypt NextAuth.js tokens.
# Generate with:
#   macOS/Linux: openssl rand -base64 32
#   Windows:     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
NEXTAUTH_SECRET=

# ------------------------------------------------------------
# DOCKER
# ------------------------------------------------------------
# "dev" = hot reload | "prod" = optimized build
FRONTEND_TARGET=dev
